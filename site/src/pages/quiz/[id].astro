---
// One weekly quiz. The rules (window, attempts, solutions) are applied in the browser.
import { renderMathText, rulesText, windowText } from '@abacus/quiz'
import { weeklyQuizzes } from '@abacus/quizzes'
import { WeeklyQuizIsland } from '../../islands'
import Seite from '../../layouts/Seite.astro'
import { scope, url } from '../../config'

export function getStaticPaths() {
  return weeklyQuizzes.map((w) => ({ params: { id: w.id }, props: { w } }))
}
const { w } = Astro.props
---
<Seite title={w.title} summary={w.description} active="quiz" width="medium" unlisted={w.visible === false}>
  <p class="eyebrow"><a href={url('/quiz')}>Quizze</a>{w.week !== undefined && <> · Woche {w.week}</>}</p>
  <h1>{w.title}</h1>
  {w.description && <p class="lead" set:html={renderMathText(w.description)} />}
  <p class="quiz-meta">
    {windowText(w) && <span>{windowText(w)}</span>}
    <span>{w.questions.length} Fragen · {rulesText(w)}</span>
  </p>
  <WeeklyQuizIsland client:load id={w.id} scope={scope} />
</Seite>
