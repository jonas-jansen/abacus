---
import { NotebookBar, NotebookOverview } from '@abacus/quiz'
import Seite from '../layouts/Seite.astro'
---
<Seite title="Notizbuch" width="narrow" active="notizbuch">
  <h1>Notizbuch</h1>
  <p class="lead">
    Alle Ihre Antworten und Quizversuche – nur auf diesem Gerät, nicht übertragen. Exportieren Sie regelmäßig; mit
    „Importieren“ holen Sie sie auf einem anderen Gerät zurück.
  </p>
  <NotebookBar client:load />
  <NotebookOverview client:only="react" />
</Seite>
