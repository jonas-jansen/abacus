---
// Course page: text and quizzes in a reading column, the page's applet large and sticky beside
// it. Narrow screens stack them, applet first.
import { getCollection, render } from 'astro:content'
import { getApplet } from '@abacus/applets'
import { vocabulary } from '../../components'
import { AppletIsland } from '../../islands'
import Seite from '../../layouts/Seite.astro'
import { url } from '../../config'

export async function getStaticPaths() {
  const pages = await getCollection('course', (s) => import.meta.env.DEV || !s.data.draft)
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }))
}

const { page } = Astro.props
const { data } = page
Astro.locals.applet = data.applet
const def = getApplet(data.applet)
const { Content } = await render(page)
---
<Seite title={data.title} summary={data.summary} active="kurs">
  <header class="course-head">
    <p class="eyebrow">Woche {data.week}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>
  </header>
  <div class="course">
    <article class="course-text prose">
      <Content components={vocabulary} />
    </article>
    <div class="course-applet">
      <div class="course-applet-sticky">
        <AppletIsland
          client:load
          id={def.id}
          initialState={data.state}
          startLocked={data.locked}
          pageHref={url(`/applet/${def.id}`)}
        />
      </div>
    </div>
  </div>
</Seite>
