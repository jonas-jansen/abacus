---
// Explore page: one applet, full width, nothing else in the way.
import { getCollection } from 'astro:content'
import { applets, getApplet } from '@abacus/applets'
import { AppletIsland } from '../../islands'
import Seite from '../../layouts/Seite.astro'
import { url } from '../../config'

export function getStaticPaths() {
  return Object.keys(applets).map((id) => ({ params: { id } }))
}

const { id } = Astro.params
const def = getApplet(id!)
const pages = (await getCollection('course', (s) => s.data.applet === id && (import.meta.env.DEV || !s.data.draft))).sort(
  (a, b) => a.data.week - b.data.week,
)
---
<Seite title={def.title} summary={def.summary} active="applets" unlisted={def.visible === false}>
  <div class="explore-head">
    <div>
      <p class="eyebrow chapter-badge">
        <a href={url(`/applets#kapitel-${def.chapter}`)}>{def.chapter === 'Appendix' ? 'Anhang' : `Kapitel ${def.chapter}`}</a>
        {def.slides && <span> · Folien {def.slides}</span>}
      </p>
      <h1>{def.title}</h1>
      <p class="lead">{def.summary}</p>
    </div>
    {
      pages.length > 0 && (
        <div class="explore-links">
          <span class="eyebrow">Im Kurs</span>
          {pages.map((s) => (
            <a class="chip" href={url(`/kurs/${s.id}`)}>
              {s.data.title} →
            </a>
          ))}
        </div>
      )
    }
  </div>
  <AppletIsland client:load id={def.id} showHeader={false} />
</Seite>
