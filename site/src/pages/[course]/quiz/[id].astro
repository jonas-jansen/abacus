---
// One weekly quiz. The rules (window, attempts, solutions) are applied in the browser.
import { renderMathText, rulesText, windowText } from '@abacus/quiz'
import { weeklyQuizzes } from '@abacus/quizzes'
import { WeeklyQuizIsland } from '../../../islands'
import Seite from '../../../layouts/Seite.astro'
import { scopeOf, type Course } from '../../../courses'
import { courseUrl } from '../../../config'
import { included, builtCourses } from '../../../release'

export function getStaticPaths() {
  const ws = weeklyQuizzes.filter((w) => included('quizzes', w.id))
  return builtCourses.flatMap((course) => ws.map((w) => ({ params: { course: course.id, id: w.id }, props: { w, course } })))
}
const { w, course } = Astro.props as { w: (typeof weeklyQuizzes)[number]; course: Course }
Astro.locals.course = course
---
<Seite course={course} title={w.title} summary={w.description} active="quiz" width="medium" unlisted={w.visible === false}>
  <p class="eyebrow"><a href={courseUrl(course, '/quiz')}>Quizze</a>{w.week !== undefined && <> · Woche {w.week}</>}</p>
  <h1>{w.title}</h1>
  {w.description && <p class="lead" set:html={renderMathText(w.description)} />}
  <p class="quiz-meta">
    {windowText(w) && <span>{windowText(w)}</span>}
    <span>{w.questions.length} Fragen · {rulesText(w)}</span>
  </p>
  <WeeklyQuizIsland client:load id={w.id} scope={scopeOf(course)} />
</Seite>
