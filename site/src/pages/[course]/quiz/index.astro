---
import { renderMathText, rulesText, windowText } from '@abacus/quiz'
import { listedWeeklyQuizzes } from '@abacus/quizzes'
import { WeeklyQuizStatusIsland } from '../../../islands'
import Seite from '../../../layouts/Seite.astro'
import { scopeOf, type Course } from '../../../courses'
import { courseUrl } from '../../../config'
import { included, release, builtCourses } from '../../../release'
export function getStaticPaths() {
  return builtCourses.map((course) => ({ params: { course: course.id }, props: { course } }))
}
const { course } = Astro.props as { course: Course }
Astro.locals.course = course
---
<Seite course={course} title="Quizze" active="quiz" width="medium">
  <h1>Quizze</h1>
  <ol class="quiz-list">
    {
      listedWeeklyQuizzes({ all: import.meta.env.DEV || !!release }).filter((w) => included('quizzes', w.id)).map((w) => (
        <li>
          <a href={courseUrl(course, `/quiz/${w.id}`)}>
            <span class="course-week">{w.week !== undefined ? `Woche ${w.week}` : 'Quiz'}</span>
            <strong>{w.title}{w.visible === false && <span class="nicht-gelistet">nicht gelistet</span>}</strong>
            {w.description && <span class="course-kurz" set:html={renderMathText(w.description)} />}
            <span class="quiz-meta">
              {windowText(w) && <span>{windowText(w)}</span>}
              <span>{w.questions.length} Fragen · {rulesText(w)}</span>
            </span>
            <WeeklyQuizStatusIsland client:only="react" id={w.id} scope={scopeOf(course)} />
          </a>
        </li>
      ))
    }
  </ol>
</Seite>
