---
// One exercise sheet for the exercise class: a tab per part, each with its equation box and
// its scenario applet.
import Seite from '../../../layouts/Seite.astro'
import Sammlung from '../../../components/Sammlung.astro'
import { type Course } from '../../../courses'
import type { Sheet } from '../../../exercises'
import { builtCourses, builtSheets } from '../../../release'

export function getStaticPaths() {
  return builtCourses.flatMap((course) => builtSheets.map((sheet) => ({ params: { course: course.id, sheet: sheet.id }, props: { course, sheet } })))
}
const { course, sheet } = Astro.props as { course: Course; sheet: Sheet }
Astro.locals.course = course
---
<Seite course={course} title={sheet.title} active="uebung" unlisted>
  <Sammlung sheet={sheet} noun="Aufgabe" />
</Seite>
