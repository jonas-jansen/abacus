---
import { chapters } from '@abacus/applets'
import { chapterName } from '@abacus/applet-ui/define'
import Seite from '../../layouts/Seite.astro'
import { scopeOf, type Course } from '../../courses'
import { courseUrl } from '../../config'
import { builtCourses, included, listAll, release, unlistedMark } from '../../release'
import { previewSvg } from '../../preview'

// listed applets only ("sichtbar" in packages/applets/applets.json); the dev server shows all, marked
// an upload (release profile) lists exactly what it contains
const kapitelListe = chapters({ all: listAll })
  .map((k) => ({ ...k, applets: k.applets.filter((a) => included('applets', a.id)) }))
  .filter((k) => k.applets.length > 0)
// the search hint names what is there: a word from the first few titles
const beispiele = kapitelListe.flatMap((k) => k.applets).slice(0, 3).map((a) => a.title.split(/[\s:,]/)[0]).join(', ')
export function getStaticPaths() {
  return builtCourses.map((course) => ({ params: { course: course.id }, props: { course } }))
}
const { course } = Astro.props as { course: Course }
Astro.locals.course = course
---
<Seite course={course} title="Applets" active="applets">
  <h1>Applets</h1>
  <div class="gallery-search">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="m10.5 10.5 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <input id="applet-suche" type="search" placeholder={`Applet suchen, z. B. ${beispiele} …`} aria-label="Applets durchsuchen" autocomplete="off" />
  </div>
  <p id="keine-treffer" class="muted" hidden>Kein Applet passt dazu.</p>
  <nav class="chapter-nav" aria-label="Kapitel">
    {kapitelListe.map((k) => <a href={`#kapitel-${k.id}`}>{chapterName(k.id)}</a>)}
  </nav>
  {
    kapitelListe.map((k) => (
      <section class="chapter" id={`kapitel-${k.id}`}>
        <h3 class="chapter-title">
          <span class="chapter-no">{chapterName(k.id)}</span>
          {k.title}
        </h3>
        <div class="gallery">
          {k.applets.map((a) => (
            <a class="card" href={courseUrl(course, `/applet/${a.id}`)} data-suche={`${a.title} ${a.summary} ${k.title} ${chapterName(k.id)} ${a.id}`}>
              <div class="card-preview" set:html={previewSvg(a)} />
              <div class="card-body">
                {unlistedMark(a.visible) && <span class="nicht-gelistet">nicht gelistet</span>}
                <strong>{a.title}</strong>
                <span>{a.summary}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <script>
    // Filter the gallery as you type: every word must occur (umlauts and case ignored).
    const norm = (s: string) =>
      s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ß/g, 'ss')
    const input = document.getElementById('applet-suche') as HTMLInputElement | null
    const none = document.getElementById('keine-treffer')
    input?.addEventListener('input', () => {
      const words = norm(input.value).split(/\s+/).filter(Boolean)
      let shown = 0
      document.querySelectorAll<HTMLElement>('.chapter').forEach((ch) => {
        let inChapter = 0
        ch.querySelectorAll<HTMLElement>('.card').forEach((card) => {
          const text = norm(card.dataset.suche ?? '')
          const hit = words.every((w) => text.includes(w))
          card.hidden = !hit
          if (hit) inChapter++
        })
        ch.hidden = inChapter === 0
        shown += inChapter
      })
      if (none) none.hidden = shown > 0
    })
  </script>
</Seite>
