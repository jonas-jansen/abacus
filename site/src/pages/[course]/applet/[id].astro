---
// Explore page: one applet, full width, nothing else in the way.
import { getCollection, getEntry, render } from 'astro:content'
import { applets, getApplet } from '@abacus/applets'
import { chapterName } from '@abacus/applet-ui/define'
import { AppletIsland } from '../../../islands'
import Seite from '../../../layouts/Seite.astro'
import { scopeOf, type Course } from '../../../courses'
import { courseUrl } from '../../../config'
import { builtCourses, included, release, showAll } from '../../../release'

export function getStaticPaths() {
  const ids = Object.keys(applets).filter((id) => included('applets', id))
  return builtCourses.flatMap((course) => ids.map((id) => ({ params: { course: course.id, id }, props: { course } })))
}
const { course } = Astro.props as { course: Course }
Astro.locals.course = course

const { id } = Astro.params
const def = getApplet(id!)
const intro = await getEntry('intro', id!)
const Intro = intro ? (await render(intro)).Content : null
const pages = (await getCollection('course', (s) => s.data.applet === id && (showAll || !s.data.draft) && included('pages', s.id))).sort(
  (a, b) => a.data.week - b.data.week,
)
---
<Seite course={course} title={def.title} summary={def.summary} active="applets" unlisted={!release && def.visible === false}>
  <div class="explore-head">
    <div>
      <p class="eyebrow chapter-badge">
        <a href={courseUrl(course, `/applets#kapitel-${def.chapter}`)}>{chapterName(def.chapter)}</a>
        {def.slides && <span> · Folien {def.slides}</span>}
      </p>
      <h1>{def.title}</h1>
      <p class="lead">{def.summary}</p>
    </div>
    {
      pages.length > 0 && (
        <div class="explore-links">
          <span class="eyebrow">Im Kurs</span>
          {pages.map((s) => (
            <a class="chip" href={courseUrl(course, `/kurs/${s.id}`)}>
              {s.data.title} →
            </a>
          ))}
        </div>
      )
    }
  </div>
  <AppletIsland client:load id={def.id} showHeader={false} />
  {
    Intro && (
      <section class="applet-intro prose">
        <p class="eyebrow">{intro!.data.title}</p>
        <Intro />
      </section>
    )
  }
</Seite>
