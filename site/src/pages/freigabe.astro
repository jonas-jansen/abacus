---
// For the admin: what students see today, and what appears when. Not linked from the site.
import { getCollection } from 'astro:content'
import { kapitel } from '@abacus/applets'
import Seite from '../layouts/Seite.astro'
import { kurs, url } from '../config'
import { appletFreigabe, freigabeText, heute, offen, planOderFehler, seitenFreigabe } from '../freigabe'

const seiten = (await getCollection('seiten')).sort((a, b) => a.data.woche - b.data.woche || a.data.titel.localeCompare(b.data.titel, 'de'))
const plan = planOderFehler(seiten.map((s) => s.id))
const tag = heute()
const datum = (d: string) => new Intl.DateTimeFormat('de-DE', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`))
const status = (v: string) => (offen(v, tag) ? 'sichtbar' : v === 'verborgen' ? 'verborgen' : 'geplant')
const herkunft = (id: string, k: string) => (id in plan.applets ? 'eigene Angabe' : k in plan.kapitel ? (k === 'Anhang' ? 'wie Anhang' : `wie Kapitel ${k}`) : 'Standard')
// a released course page whose applet is not released yet: students would see a page without it
const konflikte = seiten.filter((s) => {
  const sv = seitenFreigabe(s)
  const av = appletFreigabe(s.data.applet)
  if (sv === 'verborgen') return false
  if (av === 'verborgen') return true
  if (av === 'sofort') return false
  return sv === 'sofort' || av > sv
})
---
<Seite titel="Freigabe" breite="schmal" intern>
  <p class="eyebrow">Für die Kursleitung</p>
  <h1>Freigabe</h1>
  <p class="lead">
    Was Studierende am {datum(tag)} sehen – und was wann dazukommt. Diese Seite ist nirgends verlinkt.
  </p>

  <div class="freigabe-anleitung">
    <p>
      <strong>Ändern:</strong> die Datei <code>site/freigabe.json</code> bearbeiten, z.&nbsp;B.{' '}
      <a href={kurs.freigabeBearbeiten}>direkt auf GitHub</a> („Commit changes“). Nach etwa zwei Minuten ist die
      Seite neu gebaut; Termine greifen jeden Morgen von selbst.
    </p>
    <p>
      Werte: <code>"sofort"</code>, <code>"verborgen"</code> oder ein Datum <code>"2026-11-03"</code>. Ein Applet folgt
      seinem Kapitel (<code>"kapitel"</code>), außer es steht unter <code>"applets"</code>. Kursseiten folgen ihrer Woche ab{' '}
      <code>"semesterbeginn"</code>{plan.semesterbeginn ? ` (${datum(plan.semesterbeginn)})` : ' (nicht gesetzt: alle sofort)'}; Ausnahmen
      unter <code>"seiten"</code>.
    </p>
  </div>

  {
    konflikte.length > 0 && (
      <div class="freigabe-warnung" role="alert">
        <strong>Achtung:</strong> diese Kursseiten erscheinen vor ihrem Applet:
        {konflikte.map((s) => ` ${s.data.titel} (${s.data.applet})`).join(',')}.
      </div>
    )
  }

  <h2 class="section-title">Applets</h2>
  {
    kapitel().map((k) => (
      <section class="freigabe-kapitel">
        <h3>
          {k.id === 'Anhang' ? 'Anhang' : `Kapitel ${k.id}`} <span class="muted">· {freigabeText(plan.kapitel[k.id] ?? 'sofort')}</span>
        </h3>
        <table class="freigabe-tabelle">
          <tbody>
            {k.applets.map((a) => {
              const v = appletFreigabe(a.id)
              const st = status(v)
              return (
                <tr data-status={st}>
                  <td>
                    <a href={url(st === 'sichtbar' ? `/applet/${a.id}` : `/vorschau/${a.id}`)}>{a.titel}</a>
                    <span class="freigabe-id">{a.id}</span>
                  </td>
                  <td class="freigabe-wann">
                    <span class="freigabe-status">{st === 'sichtbar' ? 'sichtbar' : freigabeText(v)}</span>
                    <span class="muted">{herkunft(a.id, k.id)}</span>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </section>
    ))
  }

  <h2 class="section-title">Kursseiten</h2>
  <table class="freigabe-tabelle">
    <tbody>
      {
        seiten.map((s) => {
          const v = seitenFreigabe(s)
          const st = status(v)
          return (
            <tr data-status={st}>
              <td>
                Woche {s.data.woche}: {st === 'sichtbar' ? <a href={url(`/kurs/${s.id}`)}>{s.data.titel}</a> : s.data.titel}
                <span class="freigabe-id">{s.id}</span>
              </td>
              <td class="freigabe-wann">
                <span class="freigabe-status">{st === 'sichtbar' ? 'sichtbar' : freigabeText(v)}</span>
                <span class="muted">{s.data.entwurf ? 'Entwurf' : s.id in plan.seiten ? 'eigene Angabe' : plan.semesterbeginn ? 'nach Woche' : 'Standard'}</span>
              </td>
            </tr>
          )
        })
      }
    </tbody>
  </table>
</Seite>
