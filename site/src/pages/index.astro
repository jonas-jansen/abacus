---
// The landing page of the platform: its courses. Everyone sees all of them for now; which
// courses a visitor sees, and whether one can join, is decided in the browser by courseAccess
// (src/access.ts), so a login later needs no change here.
import Seite from '../layouts/Seite.astro'
import { courseUrl, platform } from '../config'
import { builtCourses } from '../release'
---
<Seite title={platform.name} width="medium">
  <h1>Kurse</h1>
  <div class="kurse" id="kurse-mine">
    {
      builtCourses.map((c) => (
        <a class="bereich kurs-karte" href={courseUrl(c)} data-course={c.id}>
          <span class="bereich-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20c3-12 6-12 9 0s6 0 9-14" /></svg>
          </span>
          <strong>{c.title}</strong>
          <span class="bereich-detail">{c.term}</span>
        </a>
      ))
    }
  </div>
  <section id="kurse-weitere" hidden>
    <h2>Weitere Kurse</h2>
    <div class="kurse"></div>
  </section>

  <script>
    // With a login (courseAccess.mine() gives the visitor's courses), the others move under
    // "Weitere Kurse", with a button to join when joining is possible. Today mine() is null.
    import { courseAccess } from '../access'
    const mine = await courseAccess.mine()
    if (mine) {
      const weitere = document.getElementById('kurse-weitere')!
      const ziel = weitere.querySelector('.kurse')!
      for (const karte of document.querySelectorAll<HTMLAnchorElement>('#kurse-mine [data-course]')) {
        const id = karte.dataset.course!
        if (mine.includes(id)) continue
        ziel.append(karte)
        if (courseAccess.join) {
          const knopf = document.createElement('button')
          knopf.type = 'button'
          knopf.className = 'kurs-beitreten'
          knopf.textContent = 'Kurs beitreten'
          knopf.addEventListener('click', async (e) => {
            e.preventDefault()
            await courseAccess.join!(id)
            location.href = karte.href
          })
          karte.append(knopf)
        }
      }
      weitere.hidden = ziel.childElementCount === 0
    }
  </script>
</Seite>
