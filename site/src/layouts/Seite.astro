---
import '@abacus/applet-ui/styles.css'
import '@abacus/quiz/styles.css'
import '../styles/site.css'
import '../styles/thema.css'
import { EINSTELLUNGEN, EINSTELLUNGEN_SCRIPT, FARBEN } from '@abacus/applet-ui/settings'
import { courseUrl, platform, url } from '../config'
import type { Course } from '../courses'
import { builtLectures, builtSheets, withPages } from '../release'

interface Props {
  title: string
  summary?: string
  /** Page width: 'wide' for applet and course pages, 'medium' for quizzes, 'narrow' for text pages. */
  width?: 'wide' | 'medium' | 'narrow'
  active?: 'start' | 'applets' | 'kurs' | 'vorlesung' | 'quiz' | 'uebung' | 'notizbuch'
  /** Reachable by its address, but not listed: kept out of search engines too. */
  unlisted?: boolean
  /** The course the page belongs to: its name and areas in the top bar. None on the landing page. */
  course?: Course
  /** The top bar with nav and settings; the landing page has its own header instead. */
  topbar?: boolean
}
const { title, summary, width = 'wide', active, unlisted = false, course, topbar = true } = Astro.props
const c = (path: string) => courseUrl(course!, path)
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- added to the home screen (iPad: Share → Zum Home-Bildschirm), abacus opens as an app
         without the browser's bars: the most room for the beamer -->
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="abacus" />
    <meta name="theme-color" content="#003f75" />
    <title>{course ? `${title} · ${course.title}` : title}</title>
    {summary && <meta name="description" content={summary} />}
    {unlisted && <meta name="robots" content="noindex" />}
    <script is:inline set:html={EINSTELLUNGEN_SCRIPT} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    {topbar && (
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={url('/')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M3 20c3-12 6-12 9 0s6 0 9-14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          {platform.name}
        </a>
        {course && <a class="brand-course" href={c('/')}>{course.title}</a>}
        {course && (
          <nav>
            <a href={c('/applets')} aria-current={active === 'applets' ? 'page' : undefined}>Applets</a>
            {withPages && <a href={c('/kurs')} aria-current={active === 'kurs' ? 'page' : undefined}>Kurs</a>}
            {builtLectures.length > 0 && <a href={c('/vorlesung')} aria-current={active === 'vorlesung' ? 'page' : undefined}>Vorlesung</a>}
            <a href={c('/quiz')} aria-current={active === 'quiz' ? 'page' : undefined}>Quizze</a>
            {builtSheets.length > 0 && <a href={c('/uebung')} aria-current={active === 'uebung' ? 'page' : undefined}>Übungen</a>}
            <a href={c('/notizbuch')} aria-current={active === 'notizbuch' ? 'page' : undefined}>Notizbuch</a>
          </nav>
        )}
        <button class="settings-btn" type="button" popovertarget="einstellungen" aria-label="Einstellungen">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h10M18 7h2M4 17h4M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" />
          </svg>
        </button>
        <div id="einstellungen" class="settings" popover>
          <div class="settings-title">Farben</div>
          <div class="settings-seg" role="radiogroup" aria-label="Farben">
            {FARBEN.map((f) => (
              <button type="button" role="radio" data-farbe={f.wert} aria-checked={f.wert === 'auto' ? 'true' : 'false'}>{f.label}</button>
            ))}
          </div>
          <div class="settings-title">Anzeige</div>
          {Object.entries(EINSTELLUNGEN).filter(([, e]) => !('werte' in e)).map(([name, e]) => (
            <label class="settings-row">
              <span class="settings-label">{e.label}</span>
              <input type="checkbox" role="switch" data-einstellung={name} checked />
            </label>
          ))}
          {Object.entries(EINSTELLUNGEN).flatMap(([name, e]) => ('werte' in e ? [{ name, e }] : [])).map(({ name, e }) => (
            <>
              <div class="settings-sub">{e.label}</div>
              <div class="settings-seg" role="radiogroup" aria-label={e.label}>
                {e.werte.map((w) => (
                  <button type="button" role="radio" data-wahl={name} data-wert={w.wert} aria-checked={w.wert === e.standard ? 'true' : 'false'}>{w.label}</button>
                ))}
              </div>
            </>
          ))}
        </div>
      </div>
    </header>
    )}
    <slot name="hero" />
    <main class:list={['main', width]}>
      <slot />
    </main>
    <script>
      import { einstellung, farbe, setEinstellung, setFarbe, type Einstellung, type Farbe } from '@abacus/applet-ui/settings'
      for (const box of document.querySelectorAll<HTMLInputElement>('input[data-einstellung]')) {
        const name = box.dataset.einstellung as Einstellung
        box.checked = einstellung(name) !== 'aus'
        box.addEventListener('change', () => setEinstellung(name, box.checked ? 'an' : 'aus'))
      }
      // choices of several values (lines between points, thickness): one button each
      const wahl = document.querySelectorAll<HTMLButtonElement>('button[data-wahl]')
      const zeigeWahl = () => wahl.forEach((b) => b.setAttribute('aria-checked', String(einstellung(b.dataset.wahl as Einstellung) === b.dataset.wert)))
      zeigeWahl()
      for (const b of wahl) {
        b.addEventListener('click', () => {
          setEinstellung(b.dataset.wahl as Einstellung, b.dataset.wert!)
          zeigeWahl()
        })
      }
      const knoepfe = document.querySelectorAll<HTMLButtonElement>('button[data-farbe]')
      const zeige = (f: Farbe) => knoepfe.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.farbe === f)))
      zeige(farbe())
      for (const b of knoepfe) {
        b.addEventListener('click', () => {
          const f = b.dataset.farbe as Farbe
          setFarbe(f)
          zeige(f)
        })
      }
    </script>
  </body>
</html>
