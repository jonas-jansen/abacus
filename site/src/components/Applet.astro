---
// A further applet inside the prose. The page's main applet comes from the frontmatter.
//   <Applet id="geometric" state={{ a: -0.9 }} />
import { AppletIsland } from '../islands'
import { courseUrl } from '../config'

interface Props {
  id: string
  /** Opening parameters. */
  state?: Record<string, unknown>
}
const { id, state } = Astro.props
// only used on course pages, which set their course
const course = Astro.locals.course!
---
<div class="inline-applet">
  <AppletIsland client:visible id={id} initialState={state} pageHref={courseUrl(course, `/applet/${id}`)} />
</div>
