---
// <Quiz id="log-schwelle" number={3} />            — any question from @abacus/quizzes
// <Quiz id="log-vorhersage-32" unlocks />          — answering it unlocks the page's applet
import { QuizIsland } from '../islands'
import { scope } from '../config'

interface Props {
  id: string
  number?: number | string
  /** A harder question. */
  star?: boolean
  /** Unlock the page's applet (true) or the applet with this id once answered. */
  unlocks?: boolean | string
}
const { id, number, star, unlocks } = Astro.props
const unlock = unlocks === true ? Astro.locals.applet : unlocks || undefined
---
{
  unlock ? (
    <QuizIsland client:load id={id} scope={scope} number={number} star={star} unlocks={unlock} />
  ) : (
    <QuizIsland client:visible id={id} scope={scope} number={number} star={star} />
  )
}
